{# 阅读版式（窄栏）：适合关于页、条款与长文 #}
{% extends "layout.njk" %}

{% block title %}{{ page.title }} · {{ site.title }}{% endblock %}
{% block description %}{{ seoDescription or site.description }}{% endblock %}

{% block content %}
  {% include "partials/header-compact.njk" %}
  <main id="main">
    <div class="shell shell-narrow">
      <div class="article-head">
        <p class="label">Page · 页面</p>
        <h1 class="article-title">{% if content %}{{ content.title }}{% else %}{{ page.title }}{% endif %}</h1>
        {% if content and content.updatedAt %}
          <div class="article-byline">
            <span>最后更新 <time datetime="{{ content.updatedAt | date('YYYY-MM-DD') }}">{{ content.updatedAt | date('YYYY-MM-DD') }}</time></span>
          </div>
        {% endif %}
      </div>
      <article class="prose prose-narrow" data-prose data-rn-shortcodes>
        {% if content and content.html %}
          {{ content.html }}
        {% else %}
          <p class="muted">该页面暂无正文。</p>
        {% endif %}
      </article>
    </div>
  </main>
{% endblock %}
