{#
  分类 / 标签归档页（kind = archive）。
  ricenote 没有独立的 /archive 路由，归档由分类与标签页产出（term.category / term.tag），
  因此这里按 term 输出标题与说明，并把文章按年份分组。
#}
{% extends "layout.njk" %}
{% import "partials/list-rows.njk" as rows with context %}

{% block title %}{{ term.name }} · {{ site.title }}{% endblock %}

{% block content %}
  {% include "partials/header-compact.njk" %}
  <main id="main">
    <div class="shell">
      <div class="page-head">
        <p class="label">{{ 'Category · 分类' if term.type == 'category' else 'Tag · 标签' }}</p>
        <h1 class="page-title">{{ term.name }}</h1>
        <p class="page-lead">
          共 {{ posts.total }} 篇{% if pagination and pagination.totalPages > 1 %} · 第 {{ pagination.page }} / {{ pagination.totalPages }} 页{% endif %}
        </p>
      </div>

      {% if posts and posts.items.length %}
        {#
          按年份分组前先给每篇标上年份。
          ⚠️ nunjucks 的 groupby 返回的是**普通对象**（键 = 年份，值 = 该年的条目数组），
          不是 Jinja 文档里那种 [{ grouper, list }] 数组：写 {% for group in ... %} 会一个都迭代不到，
          而 | length 依然会给出组数 —— 很容易误以为分组成功，实际归档页只输出一个空的 .year-list。
          因此必须用双变量写法 {% for 键, 值 in ... %}。
        #}
        {% set yearRows = [] %}
        {% for item in posts.items %}
          {% set yearRows = yearRows.concat([{ post: item, year: ((item.publishedAt | date('YYYY')) or '未知年份') }]) %}
        {% endfor %}
        <div class="year-list">
          {% for year, group in yearRows | groupby('year') %}
            <section class="year-block">
              <div class="year-head">
                <span class="yr">{{ year }}</span>
                <span class="count">{{ group | length }} 篇</span>
                <span class="rule" aria-hidden="true"></span>
              </div>
              {% for row in group %}{{ rows.row(row.post) }}{% endfor %}
            </section>
          {% endfor %}
        </div>
        {% include "partials/pagination.njk" %}
      {% else %}
        <section class="empty-state">
          <p class="label">这里还没有内容</p>
          <p>该{{ '分类' if term.type == 'category' else '标签' }}下暂无已发布文章。</p>
        </section>
      {% endif %}
    </div>
  </main>
{% endblock %}
