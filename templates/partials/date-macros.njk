{#
  日期输出宏。

  为什么不用 `publishedAt | date('DD MMM YYYY')`：
  ricenote 的 date 过滤器只认 YYYY / MM / DD / HH / mm / ss 六个 token，
  `MMM` 会被拆成 `MM` + 残留的 `M`，输出会变成「14 10M 2026」。
  因此这里按月号查表生成英文缩写，既满足规范「日期可用英文月份缩写、全站格式统一」，
  又不依赖过滤器不支持的 token。
#}

{% macro editorial(value) %}
  {%- if not value -%}
  {%- else -%}
    {%- set monthIndex = (value | date('MM')) | int -%}
    {%- set months = ['JAN', 'FEB', 'MAR', 'APR', 'MAY', 'JUN', 'JUL', 'AUG', 'SEP', 'OCT', 'NOV', 'DEC'] -%}
    {{- (value | date('DD')) ~ ' ' ~ (months[monthIndex - 1] or '') ~ ' ' ~ (value | date('YYYY')) -}}
  {%- endif -%}
{% endmacro %}

{% macro iso(value) %}
  {{- (value | date('YYYY-MM-DD')) -}}
{% endmacro %}
