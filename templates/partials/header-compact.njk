{#
  紧凑 Header：文章页与所有次级页面共用。

  - 左侧返回入口指向首页（明确路径，直达页面时同样合理）；
  - 文章页右侧为 目录 / 阅读设置 / INDEX，均按主题设置显隐；
  - 阅读设置只用一个齿轮图标（文案在「阅读设置」抽屉里），避免顶栏过长；
  - INDEX 与首页刊头复用同一套 `.index-trigger` 样式与图标，两处入口观感一致；
  - 复制链接不放在顶栏（顶栏空间留给导航），改在「阅读设置」抽屉里提供；
  - 底边进度线只在文章页出现，进度只统计正文区域。
#}
{% set isPost = page.kind == 'post' %}
<header class="reader-head" id="reader-head">
  <div class="shell">
    <div class="reader-bar">
      <a class="reader-brand" href="{{ url('home') }}">
        <span class="back" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
        </span>
        <span>{{ site.title }}.</span>
      </a>
      <div class="reader-tools">
        {% if isPost and theme.settings.showToc %}
          <button class="btn btn-quiet" type="button" data-drawer-open="toc" aria-expanded="false" aria-controls="toc-drawer" aria-label="文章目录">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true" focusable="false"><path d="M4 6h16M4 12h16M4 18h9"/></svg>
            <span class="tool-text">目录</span>
          </button>
        {% endif %}
        {% if isPost and theme.settings.showReadingTools %}
          <button class="btn btn-quiet btn-icon" type="button" data-drawer-open="tools" aria-expanded="false" aria-controls="tools-drawer" aria-label="阅读设置" title="阅读设置">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
          </button>
        {% endif %}
        <button class="index-trigger" type="button" data-drawer-open="index" aria-expanded="false" aria-controls="index-drawer">
          <span>Index</span>
          <span class="index-glyph" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M4 7h16M4 12h16M4 17h10"/></svg>
          </span>
        </button>
      </div>
    </div>
  </div>
  {% if isPost and theme.settings.showProgress %}
    <div class="progress-track" role="progressbar" aria-label="文章阅读进度" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0">
      <span class="bar" data-progress></span>
    </div>
  {% endif %}
</header>
